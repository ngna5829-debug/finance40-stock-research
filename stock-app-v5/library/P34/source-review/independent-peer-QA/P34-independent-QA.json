  "all50rules_whole_continuous_original_discourse_linked": true,
  "necessary_rule_field_changes": [
    {
      "rule_id": "P34-R14",
      "field": "author_meaning",
      "old": "脚注记1922四月二十五日建议暂不融资买，因市场涨太快，之后有回落又给买入时机。",
      "new": "脚注记一九二二年四月二十五日建议客户暂缓保证金买入，因为市场上涨过快；作者随后记市场出现明显回落。脚注未说回落后又发出买入建议。"
    },
    {
      "rule_id": "P34-R12",
      "field": "author_meaning",
      "old": "作者买价显著低于内在价值才叫便宜，早四月NYSE有很多，但也有现在与永远都无价值的上市股票。",
      "new": "作者将买价显著低于内在价值称为便宜；认为四月上旬纽约交易所有很多这样的股票，另说有些上市股或许没有内在价值且以后也不会有。"
    },
    {
      "rule_id": "P34-R12",
      "field": "counterexample_or_limit",
      "old": "原书明确NYSE也有永无价值之股。",
      "new": "原书明确提出纽约交易所也可能有始终无内在价值的股票。"
    },
    {
      "rule_id": "P34-R22",
      "field": "author_meaning",
      "old": "利润兑现、传闻和空头卖可致短降，补空加新买且牛市条件好才可能新高；熊市也有反弹。作者重主要运动而非急逐小波。",
      "new": "作者说牛市中人们等待回调、报纸预测、买入暂缓与空头卖出会使价格下降；新买与补空令其再升，若牛市条件有利会高于此前；熊市也有反弹。他偏重主要运动，次要利用小波动。"
    },
    {
      "rule_id": "P34-R29",
      "field": "author_meaning",
      "old": "旧最低自有20%、银行通常贷80%，全款购再外借仍有融资，与住宅分期作类比；部分抵押不获贷则经纪自筹。",
      "new": "作者说普通最低自有款约两成、银行通常贷股票市值八成，股票全款购入但另向银行借款仍有融资，并以借款购买住房作类比；若股票不被银行接受抵押，不应期待经纪提供保证金购买，若仍提供作者怀疑其似bucket shop。"
    },
    {
      "rule_id": "P34-R30",
      "field": "author_meaning",
      "old": "作者因最低款易被追加、被迫卖，常建议30–50%、有时至少50%或根本不融资；按期派息的低价全款存券是偏好。",
      "new": "作者因最低保证金容易被追加款项，建议无法随时补款者缩小购买并放较厚保证金；常建议三成至五成、有时至少五成或完全不融资。对想免忧者建议低价全款买入并取券存安全箱，又说低价用充足保证金风险很小、利润可能更大。"
    },
    {
      "rule_id": "P34-R32",
      "field": "independent_analysis",
      "old": "100%是价相对价值并非美元点；高估不是择时证据，也不是短兴趣必涨。",
      "new": "百分之一百是价格相对价值的比例而非美元点；高估不是择时证据，空头头寸较大也不是价格必涨的充分条件。"
    },
    {
      "rule_id": "P34-R39",
      "field": "author_meaning",
      "old": "发明失败不常被听见，商业95%失败作者不知道真假；超过80%融资交易者亏是引述，作者归因无知贪婪与机会过大。",
      "new": "发明失败不常被听见，商业百分之九十五失败作者不知道真假；超过百分之八十保证金交易者亏是引述，作者归因于无知、贪婪和过度冒险。"
    },
    {
      "rule_id": "P34-R33",
      "field": "author_meaning",
      "old": "bucket指对客户声称买却未买或马上卖；上下或下跌可使它盈利，连续上涨会承压。作者说1921八月至写时多于50失败、除少数无三点反应。",
      "new": "作者定义bucket为以保证金给客户股票交易却未为其买入或买后即卖；下跌或来回波动可使其获利，连续上涨会承压。他说股价自一九二一年八月上升至写作时多数没有三点回调，又记此类机构自一九二二年初至四月写作时失败逾五十。"
    },
    {
      "rule_id": "P34-R34",
      "field": "author_meaning",
      "old": "作者偏NYSE会员，承認偶失败或bucket而罕见；不愿推荐以免担保全对，任何经纪仍应取责任报告，Bradstreet/Dun或朋友银行可帮助。",
      "new": "作者偏好纽约交易所会员，承认会员偶有失败或经营、关联bucket shop而称较罕见；可应要求提供会员名称，但不愿推荐任何经纪，并明说不能保证可靠。无论选谁仍应取责任能力报告，Bradstreet、Dun或朋友、银行可帮助取得。"
    },
    {
      "rule_id": "P34-R36",
      "field": "author_meaning",
      "old": "作者不推荐一般外部人买put/call，专业有时可用，因写约者定条件偏向自身；多数亏是未证强意见。",
      "new": "作者不推荐一般外部人买put/call，认为专业投机者有时可利用，写约者会设定偏向自身的条件；他认同几乎所有买约者亏损的说法。"
    },
    {
      "rule_id": "P34-R36",
      "field": "independent_analysis",
      "old": "写约者不自动必胜、买约者不自动必输，读完书或专家名称不形成资格与概率。",
      "new": "原章未给几乎全亏的样本或效果验证；写约者不自动必胜、买约者不自动必输，读完书或专家名称不形成资格与概率。"
    },
    {
      "rule_id": "P34-R45",
      "field": "author_meaning",
      "old": "Babson转引经理信描述询谷物被诱买SouthernPacific百股，经纪错仍有佣金；99%tips未有调查，10股/100股同资金使佣金放大十倍。",
      "new": "本书经Babson转引经理来信，叙述询问谷物的客户被诱买Southern Pacific一百股，建议错了经纪仍有佣金；来信人估计百分之九十九投机基于tips，并用同额资金全款买十股与一成保证金买一百股说明佣金扩大十倍。"
    },
    {
      "rule_id": "P34-R45",
      "field": "independent_analysis",
      "old": "匿名叙述未验回单，two ways不等上涨半概率；净盈亏十倍还缺融资费，不按例推现行佣金。",
      "new": "匿名叙述未核回单，百分之九十九是来信人的估计、原章未附调查；two ways不等于上涨概率二分之一。净盈亏十倍还缺融资费，不按例推现行佣金。"
    },
    {
      "rule_id": "P34-R25",
      "field": "author_meaning",
      "old": "作者劝全款或较重自有款持有廉价，因所需时间不能准确知；发现错越早卖亏越好。",
      "new": "作者劝买实际或未来价值远超过市价的股票，以全款或较厚保证金持有，直到价格上涨；一旦发现判断出错，应越早卖出承担损失越好。"
    },
    {
      "rule_id": "P34-R25",
      "field": "independent_analysis",
      "old": "heavy margin指多交现金而非更高杠杆；最终价值回归未经证明，不能永不改判。",
      "new": "原章未给价值回归的到达时间；heavy margin指多交现金而非更高杠杆。最终价值回归未经证明，不能永不改判。"
    }
