      "id": "P28-R14",
      "chapter_numbers": [
        1,
        4,
        5,
        6,
        7
      ],
      "name_zh": "明确处理不报价与假稳定的书内张力",
      "author_basis_zh": "作者有时赞赏不报价资产的账面稳定，又承认不活跃形成虚假稳定；知识角色须同时保存两种表述。",
      "required_inputs": [
        "marketExecutableQuotes",
        "valuationEvidence",
        "cashNeedsSchedule"
      ],
      "horizon_zh": "当前可售日期与最终偿付日期",
      "abstention_or_falsification_zh": "没有实际成交或可执行买价时不得将报价不动判成无风险。",
      "modern_boundary_zh": "以经济可回收现金优先是现代独立裁决，不冒称作者已统一解决矛盾。",
