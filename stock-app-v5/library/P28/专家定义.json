    {
      "id": "P28-R12",
      "chapter_numbers": [
        6
      ],
      "name_zh": "公共事业必须同时审资产、现金和特许权",
      "author_basis_zh": "街道铁路债需物理、财务和政治检查，特许权宜长于债券期限，还需审收费、成本、事故责任和公众关系。",
      "required_inputs": [
        "engineeringAppraisal",
        "franchiseTerms",
        "multiYearFinancials",
        "rateAndTaxConditions",
        "accidentInsuranceData"
      ],
      "horizon_zh": "债券到期与特许权剩余期间",
      "abstention_or_falsification_zh": "无特许权或收费条件时弃权；稳定客流不足以证明现金或本金安全。",
      "modern_boundary_zh": "街道铁路例不能无修订泛化到所有现代供水、电力、通信公司。",
      "chapter_sources": [
        {
          "chapter": 6,
          "print_pages": [
