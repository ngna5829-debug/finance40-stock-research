  "role_zh": "依据单本原书审查资金用途、证券权利、债券保障、变现与期限，并接受合同及财务反证。",
  "author_view_vs_modern_analysis_separated": true,
  "required_input_groups": [
    "investorNeeds",
    "securityTerms",
    "financialAndAssetEvidence",
    "datedExecutableMarketEvidence",
    "datedMacroAndBusinessEvidence"
  ],
