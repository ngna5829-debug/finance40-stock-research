    {
      "id": "P28-R15",
      "chapter_numbers": [
        8
      ],
      "name_zh": "留存盈利和稳定股息只能提供条件论证",
      "author_basis_zh": "股息平滑可能来自储备；银行留存可能增加净值，但股票仍是剩余权利，原书近乎确定升值语言应受反证约束。",
      "required_inputs": [
        "multiYearFinancials",
        "dividendHistory",
        "retainedEarnings",
        "capitalStructure"
      ],
      "horizon_zh": "多年经营与投资使用期",
      "abstention_or_falsification_zh": "缺真实盈利、资产质量、融资及股权资料时不确认净值和股价必涨。",
      "modern_boundary_zh": "反证包括亏损、稀释、估值下降与有限储备；本书未建立现代银行资产风险模型。",
      "chapter_sources": [
        {
          "chapter": 8,
          "print_pages": [
            100,
            107
          ],
          "source_lines": [
