          ],
          "dossier_file": "chapters/ch05.md"
        }
      ]
    },
    {
      "id": "P28-R04",
      "chapter_numbers": [
        1,
        3,
        9
      ],
      "name_zh": "信用安全不等于提前出售本金稳定",
      "author_basis_zh": "到期偿付与报价是不同问题；企业紧急储备应重视短期、可变现、与可能用款时间匹配的债权。",
      "required_inputs": [
        "securityTerms",
        "cashNeedsSchedule",
        "marketExecutableQuotes"
      ],
      "horizon_zh": "买入至可能出售日期",
      "abstention_or_falsification_zh": "没有可执行买价或提前用款安排时，拒绝保证本金不变。",
      "modern_boundary_zh": "第三章三年与十年债价格为历史假设算例，不是当前收益预测。",
      "chapter_sources": [
        {
          "chapter": 1,
          "print_pages": [
            7,
            22
          ],
          "source_lines": [
