  "no_current_financial_data_fabrication": true,
  "rules": [
    {
      "id": "P28-R01",
      "chapter_numbers": [
        1
      ],
      "name_zh": "先确定资金用途和真实需求",
      "author_basis_zh": "先区分营运资金、企业储备、依赖收入的私人资金与可等待增值的资金，再以安全、实际收入、变现、升值、报价稳定五维比较。",
      "required_inputs": [
        "investorNeeds",
        "cashNeedsSchedule",
        "existingEconomicExposures"
      ],
      "horizon_zh": "资金可能使用期间",
      "abstention_or_falsification_zh": "没有用途和用款期限时弃权，不能先荐证券再推测需求。",
      "modern_boundary_zh": "固定打分权重、风险预算或最小现金比例均非本书给定阈值。",
      "chapter_sources": [
        {
          "chapter": 1,
          "print_pages": [
            7,
            22
          ],
          "source_lines": [
            124,
            417
          ],
          "dossier_file": "chapters/ch01.md"
        }
      ]
    },
    {
      "id": "P28-R02",
      "chapter_numbers": [
        1,
        8
      ],
      "name_zh": "区分债权与剩余权益",
      "author_basis_zh": "付款承诺与股票剩余索取权不同；稳定股息或优先股名称不自动构成固定本息保障。",
      "required_inputs": [
        "securityTerms",
        "capitalStructure",
        "shareClassRights"
      ],
      "horizon_zh": "合同存续和可能退出期间",
      "abstention_or_falsification_zh": "合同与证券种类不明时弃权；原规则不能直接当作现行法律意见。",
      "modern_boundary_zh": "现代可赎回、可转换或优先股条款需要实际文件。",
      "chapter_sources": [
        {
          "chapter": 1,
          "print_pages": [
            7,
            22
          ],
          "source_lines": [
            124,
            417
          ],
          "dossier_file": "chapters/ch01.md"
        },
        {
          "chapter": 8,
          "print_pages": [
            100,
            107
          ],
          "source_lines": [
