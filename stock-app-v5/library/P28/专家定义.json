            2039
          ],
          "dossier_file": "chapters/ch08.md"
        }
      ]
    },
    {
      "id": "P28-R03",
      "chapter_numbers": [
        1,
        5
      ],
      "name_zh": "分散须穿透资产和负债共同事故",
      "author_basis_zh": "旧金山保险公司资产与赔付责任同地集中，说明证券数量不同不代表风险独立；工业企业储备不宜机械再集中于工业风险。",
      "required_inputs": [
        "existingEconomicExposures",
        "assetLocations",
        "liabilityScenarios"
      ],
      "horizon_zh": "危机与可能用款期间",
      "abstention_or_falsification_zh": "仅有证券代码数量时只能描述名义分散，不确认经济分散。",
      "modern_boundary_zh": "相关系数阈值、情景损失百分比均需独立设置和验证。",
      "chapter_sources": [
        {
          "chapter": 1,
          "print_pages": [
            7,
            22
          ],
          "source_lines": [
            124,
            417
          ],
          "dossier_file": "chapters/ch01.md"
        },
        {
          "chapter": 5,
          "print_pages": [
