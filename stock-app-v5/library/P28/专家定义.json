    {
      "id": "P28-R05",
      "chapter_numbers": [
        2
      ],
      "name_zh": "以买入成本上的收益比较债券",
      "author_basis_zh": "票息、剩余期限与溢折价共同决定收益基础；票息不能全部等同可消费收入。",
      "required_inputs": [
        "securityTerms",
        "purchasePrice",
        "cashFlowSchedule"
      ],
      "horizon_zh": "到期或实际持有期间",
      "abstention_or_falsification_zh": "缺现金流日期、赎回或费用资料时，不给准确现代收益率。",
      "modern_boundary_zh": "百分之六、八年、一百一十又四分之三与约百分之四点四是原书例子。",
      "chapter_sources": [
        {
          "chapter": 2,
          "print_pages": [
            23,
            39
          ],
          "source_lines": [
            418,
            761
          ],
          "dossier_file": "chapters/ch02.md"
        }
      ]
    },
    {
      "id": "P28-R06",
      "chapter_numbers": [
        2
      ],
      "name_zh": "铁路抵押债同时查资产顺位与盈利",
      "author_basis_zh": "读取信托契约和年报；比较总债务、先后顺位、线路价值、收入、维护和固定费用，不能只查单个发行额。",
      "required_inputs": [
        "indenture",
        "debtPriorityTable",
        "multiYearFinancials",
        "assetAppraisal",
        "maintenanceAccounts"
      ],
      "horizon_zh": "经营周期及债券持有期",
      "abstention_or_falsification_zh": "担保范围、优先债务或维护资料缺失即弃权；行业合计不是个体安全证明。",
      "modern_boundary_zh": "原书固定费用两倍为1908铁路筛选口径，不能统一套给现代行业。",
      "chapter_sources": [
        {
          "chapter": 2,
          "print_pages": [
            23,
            39
          ],
          "source_lines": [
            418,
            761
          ],
          "dossier_file": "chapters/ch02.md"
        }
      ]
    },
    {
      "id": "P28-R07",
      "chapter_numbers": [
        3
      ],
      "name_zh": "设备债保障依赖可核查合同机制",
      "author_basis_zh": "产权留在受托人、设备可移动、维修保险及摊还在寿命内，是历史设备债保障机制。",
      "required_inputs": [
        "equipmentTrustTerms",
        "equipmentInventory",
        "maintenanceInsurance",
        "amortizationSchedule"
      ],
      "horizon_zh": "设备经济寿命与债务清偿期间",
      "abstention_or_falsification_zh": "没有产权及回收条件时不得继承1888—1905历史样本安全结论。",
      "modern_boundary_zh": "历史司法优先权不是现代自动法律门；二手处置与技术淘汰需独立核实。",
      "chapter_sources": [
        {
          "chapter": 3,
          "print_pages": [
            40,
            50
          ],
          "source_lines": [
            762,
            972
          ],
          "dossier_file": "chapters/ch03.md"
        }
      ]
    },
    {
      "id": "P28-R08",
      "chapter_numbers": [
        4
      ],
      "name_zh": "抵押比例须放在估值和地产周期中",
      "author_basis_zh": "低贷款比例也可能是在过热高估值上计算；本金担保与物业经营付息来源应分别审查。",
      "required_inputs": [
        "mortgageTerms",
        "titleEvidence",
        "propertyAppraisal",
        "borrowerCashFlows",
        "localMarketEvidence"
      ],
      "horizon_zh": "贷款期限、处置期和地产变化期间",
      "abstention_or_falsification_zh": "无估值日期、权属或现金流时弃权；不报价不等于没有经济损失。",
      "modern_boundary_zh": "百分之五十、六十是说明风险的原例，不是本专家现代安全上限。",
      "chapter_sources": [
        {
          "chapter": 4,
          "print_pages": [
            51,
            62
          ],
          "source_lines": [
            973,
            1201
          ],
          "dossier_file": "chapters/ch04.md"
        }
      ]
    },
    {
      "id": "P28-R09",
      "chapter_numbers": [
        4
      ],
      "name_zh": "保证须受保证人的全部责任约束",
      "author_basis_zh": "担保公司资本对总保证责任有限；个别地产下跌的分散效果不能代表全市场崩跌的承受力。",
      "required_inputs": [
        "guaranteeTerms",
        "guarantorCapital",
        "guarantorTotalExposure",
        "concentrationData"
      ],
      "horizon_zh": "担保存续及共同压力期间",
      "abstention_or_falsification_zh": "缺总责任余额或同一周期集中度时不确认保证充足。",
      "modern_boundary_zh": "六万美元贷款和三千美元支持是原书总量约束算例，不是每笔隔离准备金。",
      "chapter_sources": [
        {
          "chapter": 4,
          "print_pages": [
            51,
            62
          ],
          "source_lines": [
            973,
            1201
          ],
          "dossier_file": "chapters/ch04.md"
        }
      ]
    },
    {
      "id": "P28-R10",
      "chapter_numbers": [
        5
      ],
      "name_zh": "工业债查流动账户、稳定盈利和再融资",
      "author_basis_zh": "流动资产与流动负债、净速动资产与债务、经营盈利和偿债安排相互约束；票据不能展期可能直接造成失败。",
      "required_inputs": [
        "currentAssetDetails",
        "currentLiabilityMaturities",
        "multiYearFinancials",
        "debtSchedule"
      ],
      "horizon_zh": "季节周期、经营周期和到期安排",
      "abstention_or_falsification_zh": "存货或应收明细不明、再融资承诺未证实时应降级或弃权。",
      "modern_boundary_zh": "原书净速动资产包含存货；二比一、土地三分之二、三倍覆盖均须保留历史分母。",
      "chapter_sources": [
        {
          "chapter": 5,
          "print_pages": [
            63,
            75
          ],
          "source_lines": [
            1202,
            1449
          ],
          "dossier_file": "chapters/ch05.md"
        }
      ]
    },
    {
      "id": "P28-R11",
      "chapter_numbers": [
        2,
        5,
        6
      ],
      "name_zh": "先核必要维护和损耗再认盈利保障",
      "author_basis_zh": "减少维修或把小改良资本化可能虚增净利润；债务摊还需超过资产损耗，公共事业不能靠省略折旧支付利息。",
      "required_inputs": [
        "maintenanceAccounts",
        "depreciationPolicy",
        "capexDetails",
        "amortizationSchedule"
      ],
      "horizon_zh": "资产经济寿命和经营周期",
      "abstention_or_falsification_zh": "利润依赖漏计维护折旧时撤回原安全结论。",
      "modern_boundary_zh": "第六章每月总收入百分之十折旧属于街道铁路历史经验，非现代通用会计规则。",
      "chapter_sources": [
        {
          "chapter": 2,
          "print_pages": [
            23,
            39
          ],
          "source_lines": [
            418,
            761
          ],
          "dossier_file": "chapters/ch02.md",
