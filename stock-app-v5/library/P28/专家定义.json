        }
      ]
    },
    {
      "id": "P28-R16",
      "chapter_numbers": [
        9
      ],
      "name_zh": "分开利率力量与商业经营力量",
      "author_basis_zh": "借贷利率与商业条件可能同向或相抵，作用依证券信用和期限不同；低利率不使所有股票必涨。",
      "required_inputs": [
        "datedInterestRates",
        "businessIndicators",
        "creditEvidence",
        "securityTerms",
        "priceHistory"
      ],
      "horizon_zh": "较大商业和资金变化期间，不默认五日",
      "abstention_or_falsification_zh": "只有价格或成交量代理时弃权于资金机制判断；无法区分两力量时保留未决。",
      "modern_boundary_zh": "周期长度与价格规律是历史假说；不设原书没有的MA、RSI或校准概率。",
      "chapter_sources": [
        {
          "chapter": 9,
          "print_pages": [
