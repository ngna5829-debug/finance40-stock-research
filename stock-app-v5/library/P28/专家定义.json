    {
      "id": "P28-R13",
      "chapter_numbers": [
        7
      ],
      "name_zh": "政府债逐发行核授权、税基与真实市场",
      "author_basis_zh": "市政债需核债务与评估税基、发行目的、法定程序及变现市场；机构特殊需求也可能推高价格。",
      "required_inputs": [
        "issueAuthorization",
        "fiscalData",
        "taxBaseData",
        "debtSchedule",
        "marketExecutableQuotes"
      ],
      "horizon_zh": "财政收支与债券存续期间",
      "abstention_or_falsification_zh": "政府名称不足以证明具体债是一般征税债；缺文件即弃权。",
      "modern_boundary_zh": "当时约百分之十上限及旧银行券担保制度不是现行政策数据。",
      "chapter_sources": [
        {
          "chapter": 7,
          "print_pages": [
